# AcousticBench environment template
#
# Copy this file to `.env` in the repository root and fill in the values you
# need:
#
#   cp example.env .env
#
# `python run.py` loads `.env` automatically and never overrides variables that
# are already exported in your shell. Other tools (scripts/docker_serve.sh,
# `modal deploy`, the helper scripts in scripts/) do NOT read `.env`; export the
# variables they need in your shell instead, for example:
#
#   set -a; source .env; set +a
#
# `.env` is listed in .gitignore. Never commit real keys.

# --- API keys ---------------------------------------------------------------

# Required for every run, including open-weight models: the LLM judge
# (gpt-4o-mini-2024-07-18) extracts the A/B choice from each response. Also used by
# GPT-4o and Cascade-GPT4oTranscribe-GPT5.4.
OPENAI_API_KEY=

# Required only for the Gemini models.
GEMINI_API_KEY=

# Hugging Face token. Needed to download the gated dataset and the LoRA
# adapters, and recommended for model weight downloads. scripts/docker_serve.sh
# and `modal deploy` only see this value when it is exported in your shell.
HF_TOKEN=

# --- Docker backend endpoints -----------------------------------------------
# Ports match scripts/docker_serve.sh. The script prints the exact line to
# export once the container is healthy. Uncomment the models you serve.

# ACOUSTICBENCH_QWEN3_OMNI_ENDPOINT=http://localhost:8001
# ACOUSTICBENCH_KIMI_AUDIO_ENDPOINT=http://localhost:8002
# ACOUSTICBENCH_QWEN2_AUDIO_7B_INSTRUCT_ENDPOINT=http://localhost:8004
# ACOUSTICBENCH_MINICPM_O_4_5_ENDPOINT=http://localhost:8005
# ACOUSTICBENCH_PHI_4_MULTIMODAL_ENDPOINT=http://localhost:8006
# ACOUSTICBENCH_VOXTRAL_SMALL_24B_ENDPOINT=http://localhost:8008
# ACOUSTICBENCH_VOXTRAL_MINI_3B_ENDPOINT=http://localhost:8009
# ACOUSTICBENCH_AUDIO_FLAMINGO_3_ENDPOINT=http://localhost:8010
# ACOUSTICBENCH_KIMI_AUDIO_LORA_RAD_ENDPOINT=http://localhost:8014
# ACOUSTICBENCH_KIMI_AUDIO_LORA_RSQ_ENDPOINT=http://localhost:8015
# ACOUSTICBENCH_KIMI_AUDIO_LORA_SER_CLASSIFY_ENDPOINT=http://localhost:8016
# ACOUSTICBENCH_KIMI_AUDIO_LORA_SER_INTENSITY_ENDPOINT=http://localhost:8017
# ACOUSTICBENCH_KIMI_AUDIO_LORA_SIMPLE_AUDIOQA_ENDPOINT=http://localhost:8018
# ACOUSTICBENCH_MIMO_AUDIO_7B_ENDPOINT=http://localhost:8019
# ACOUSTICBENCH_STEP_AUDIO_2_MINI_ENDPOINT=http://localhost:8020

# --- Modal backend (optional) -----------------------------------------------
# Only used with `--backend modal`. Set it if you deployed the serving apps
# into an environment other than your Modal default (`run.py
# --modal-environment NAME` does the same). See
# harness/modal_serving/ENVIRONMENT.md for deployment steps.
# MODAL_ENVIRONMENT=acousticbench
